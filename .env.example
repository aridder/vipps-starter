# ── App & branding (RUNTIME server config — see src/lib/site.ts) ──────────
# Resolved at request time, so your platform can set these as plain app settings
# (environment variables) WITHOUT rebuilding the image. Exposed to the client
# via the meta.site tRPC query. Leave unset to use the maintainer's defaults.
APP_NAME="Vipps Starter"
SITE_TAGLINE="Gratis, åpen kildekode (MIT) for Vipps-integrasjon — Login, betaling og faste trekk. Ingenting selges her: demoen tar imot frivillige donasjoner for å vise flyten live. Klon fra GitHub."
GITHUB_URL="https://github.com/aridder/vipps-starter"
# Advertised on the landing page's "Built by" section:
AUTHOR_NAME="Asbjørn Riddervold"
AUTHOR_TAGLINE="Utvikler med sans for artige idéer og enkle løsninger. Til daglig i Kantega, ellers stadig på jakt etter nye idéer å utforske."
AUTHOR_URL="https://www.linkedin.com/in/ariddervold/"
CONTACT_EMAIL="aridder@pm.me"
# Default UI language is Norwegian ("no"); English ("en") is available via the
# in-app switcher. No env needed — the choice is stored in the NEXT_LOCALE cookie.

# ── Database (Postgres) ───────────────────────────────────────────────────
# DATABASE_URL = pooled connection (used at runtime).
DATABASE_URL="postgresql://user:pass@host-pooler.example.com/db?sslmode=require"
# DATABASE_URL_UNPOOLED = direct connection (used by migrations).
DATABASE_URL_UNPOOLED="postgresql://user:pass@host.example.com/db?sslmode=require"

# ── Auth (Auth.js / NextAuth) ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Comma-separated emails that become ADMIN on login.
ADMIN_EMAILS=""
# Dev/demo login (name + email, no password). Anyone who types an address in
# ADMIN_EMAILS becomes ADMIN, so this stays off by default. Set "true" only for
# local development; it is refused anyway once real Vipps keys are configured.
ENABLE_DEV_LOGIN="false"

# ── Feature flags ─────────────────────────────────────────────────────────
# Override defaults with "true"/"false" (see src/lib/features.ts).
FEATURE_MULTI_TENANT="true"
FEATURE_PAYMENTS="true"
FEATURE_RECURRING="true"
# Admin billing console (refunds, reserve/capture, charge ops). OFF by default —
# powerful money operations stay hidden and unusable until you enable this.
FEATURE_PAYMENT_ADMIN="false"
# QR ePayment. Uses Vipps-hosted, short-lived QR images.
FEATURE_PAYMENT_QR="true"
# Express stays off until a real physical product + fulfilment is configured.
FEATURE_PAYMENT_EXPRESS="false"
# Report API reconciliation tab for ADMIN/OWNER.
FEATURE_VIPPS_REPORTS="true"
# Contract only while Vipps Agentic Commerce is under development.
FEATURE_AGENTIC_COMMERCE="false"
FEATURE_EMAIL="false"
FEATURE_SMS="false"
FEATURE_PUSH="false"

# ── Vipps payments (ePayment + Recurring) ─────────────────────────────────
# Test base by default; set https://api.vipps.no for production.
VIPPS_API_BASE="https://apitest.vipps.no"
VIPPS_SUBSCRIPTION_KEY=""
# Single-merchant (test / one tenant): used when partner keys are unset.
VIPPS_MSN=""
VIPPS_API_CLIENT_ID=""
VIPPS_API_CLIENT_SECRET=""
# Partner / super-merchant (prod): platform keys. Each org sets its own MSN;
# money goes directly to that org. Never expose partner keys to tenants.
VIPPS_PARTNER_CLIENT_ID=""
VIPPS_PARTNER_CLIENT_SECRET=""

# ── Vipps Express product (optional) ──────────────────────────────────────
# All money fields are in øre and remain server-side. The browser never decides
# product or shipping prices. Configure a real product before enabling Express.
VIPPS_EXPRESS_PRODUCT_ID=""
VIPPS_EXPRESS_PRODUCT_NAME=""
VIPPS_EXPRESS_PRODUCT_DESCRIPTION=""
VIPPS_EXPRESS_PRODUCT_PRICE_ORE=""
VIPPS_EXPRESS_SHIPPING_ORE=""
VIPPS_EXPRESS_SHIPPING_NAME="Standardfrakt"
VIPPS_EXPRESS_ESTIMATED_DELIVERY=""

# Webhook signature: validated in WARN mode by default (mismatches logged, flow
# continues since status is fetched authoritatively). Set "true" to ENFORCE
# (401 on mismatch) once prod logs confirm real signatures verify.
VIPPS_WEBHOOK_ENFORCE_SIGNATURE="false"

# ── Vipps Login (OIDC, optional) ──────────────────────────────────────────
# Test:  https://apitest.vipps.no/access-management-1.0/access/
# Prod:  https://api.vipps.no/access-management-1.0/access/
VIPPS_CLIENT_ID=""
VIPPS_CLIENT_SECRET=""
# Left unset, the issuer follows VIPPS_API_BASE so login and payments cannot
# point at different environments. SET IT EXPLICITLY if you use Vipps Login
# WITHOUT ePayment: there is no VIPPS_API_BASE to derive from then, and the
# derived default is the test issuer.
VIPPS_ISSUER="https://apitest.vipps.no/access-management-1.0/access/"

# ── Recurring charge cron ─────────────────────────────────────────────────
# Protects /api/cron/charges. Vercel sends "Authorization: Bearer $CRON_SECRET".
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ── Notification providers (optional; stubs log until configured) ─────────
# Email (FEATURE_EMAIL): wire your provider in src/server/notify/email.ts
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@example.com"
# SMS (FEATURE_SMS): wire your provider in src/server/notify/sms.ts
SMS_ACCOUNT_SID=""
SMS_FROM=""
# Web Push (FEATURE_PUSH): VAPID keys — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
# Generated in Key Vault by the app-plattform deployment contract.
ANALYTICS_HASH_SALT=""
PLATFORM_ANALYTICS_ENABLED="true"
